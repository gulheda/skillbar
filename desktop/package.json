{
  "name": "skillbar",
  "productName": "Skillbar",
  "version": "1.0.0",
  "description": "A desktop widget for your Claude Code skills",
  "author": "Gülheda Kızılhan",
  "license": "MIT",
  "homepage": "https://github.com/gulheda/skillbar",
  "main": "main.js",
  "scripts": {
    "sync": "node -e \"const fs=require('fs');fs.mkdirSync('web',{recursive:true});for(const f of ['index.html','skills.js'])fs.copyFileSync('../app/'+f,'web/'+f)\"",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.gulheda.skillbar",
    "productName": "Skillbar",
    "files": ["main.js", "preload.js", "web/**", "icon.png", "tray.png", "tray-16.png"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }, { "target": "portable", "arch": ["x64"] }], "icon": "icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "artifactName": "Skillbar-Setup-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "Skillbar-Portable-${version}.${ext}" },
    "linux": { "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }], "category": "Utility", "icon": "icon.png", "maintainer": "gulheda" },
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "category": "public.app-category.developer-tools", "icon": "icon.png", "identity": null }
  }
}
